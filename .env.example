# ==============================================================================
# KAI: The Companion - Environment Variables Configuration Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# Never commit your actual .env file or real API keys to version control.
# ==============================================================================

# Primary LLM Provider: Groq API Key (Required for conversational AI and mindfulness suggestions)
GROQ_API_KEY=your_groq_api_key_here

# Primary LLM Model for Groq (Default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM Provider: OpenRouter API Key (Optional fallback if Groq is unavailable)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Fallback LLM Model for OpenRouter (Default: openai/gpt-3.5-turbo)
OPENROUTER_MODEL=openai/gpt-3.5-turbo

# Legacy LLM Provider: Google Gemini API Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Legacy LLM Model for Gemini (Optional)
GEMINI_MODEL_NAME=gemini-1.5-flash

# Local Server Port (Default: 5002 for local development, Hugging Face Spaces uses 7860)
PORT=5002

# Flask Debug Mode: 0 for False (Production default), 1 for True (Development)
FLASK_DEBUG=0

# Diagnostic Route Flag: Set to 1 to enable the /diagnose endpoint (Default: 0 / Disabled)
DEBUG_DIAGNOSE=0

# Diagnostic Secret Token: Required to authenticate against /diagnose if enabled (header or query param)
DIAGNOSE_TOKEN=your_diagnostic_token_here
